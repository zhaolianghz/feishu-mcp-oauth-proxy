# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，勿提交。
#   cp .env.example .env

# ---- 必填 ----

# 对外域名（不要带 https://，不要带下划线）
# ⚠️ 绝不能用下划线：_ 违反 RFC 1123，新版 OpenSSL 对 *.example.com 的
#    通配符匹配会直接判不匹配 → Python/严格 TLS 客户端全部握手失败
DOMAIN=mcp.example.com

# oauth-proxy 调上游 feishu-mcp 的 Bearer token
# 生成：openssl rand -hex 32
MCP_HTTP_TOKEN=

# 登录门密码（ChatGPT 弹出的登录页要输入它）
# 不设的话未配 GitHub OAuth 时，知道用户名就能进，而本服务能读写你的飞书文档
LOGIN_PASSWORD=

# session 密钥。不固定的话每次容器重启都要重新登录
# 生成：openssl rand -hex 32
SESSION_SECRET=

# ---- 可选 ----

# oauth-proxy 在宿主机监听的端口（默认 3011）
OAUTH_PROXY_PORT=3011

# GitHub OAuth 登录（不配则用密码门 + 用户名）
# 在 https://github.com/settings/developers 建 OAuth App，
# 回调地址填 https://${DOMAIN}/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 允许通过 GitHub 登录的用户名（逗号分隔）
GITHUB_USER=

# 排查 ChatGPT 接入问题时临时设为 1，会打印 DCR 原始请求体。排查完记得关
DEBUG_PROBE=0
